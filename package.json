{
  "name": "qqmusic-web-player",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "type": "module",
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
